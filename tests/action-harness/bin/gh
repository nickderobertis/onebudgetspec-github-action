#!/usr/bin/env python3
"""The `gh` executable: one `gh api` call sent to the doubled host exactly as gh would send it."""
import json
import os
import sys
import urllib.error
import urllib.request


def main(args):
    if args.pop(0) != 'api':
        sys.exit('gh double: only `gh api` exists here')
    include = '--include' in args
    method = None
    jq = None
    fields = {}
    path = None
    while args:
        arg = args.pop(0)
        if arg in ('--method', '-X'):
            method = args.pop(0)
        elif arg in ('--jq', '-q'):
            jq = args.pop(0)
        elif arg in ('-f', '-F', '--raw-field', '--field'):
            key, value = args.pop(0).split('=', 1)
            fields[key] = int(value) if arg in ('-F', '--field') else value
        elif arg != '--include':
            path = arg
    path = path.removeprefix('https://api.github.com/').lstrip('/')
    if path == 'graphql':
        method = 'POST'
        fields = {'query': fields.pop('query'), 'variables': fields}
    token = os.environ.get('GH_TOKEN') or os.environ.get('GITHUB_TOKEN') or ''
    request = urllib.request.Request(
        os.environ['BOUNDARY_HOST'] + '/' + path,
        data=json.dumps(fields).encode() if fields else None,
        headers={'Authorization': 'Bearer ' + token},
        method=method or ('POST' if fields else 'GET'))
    try:
        response = urllib.request.urlopen(request)
    except urllib.error.HTTPError as error:
        response = error
    data = response.read()
    if include:
        head = ['HTTP/1.1 %d Host' % response.status] + ['%s: %s' % h for h in response.headers.items()]
        sys.stdout.buffer.write(('\r\n'.join(head) + '\r\n\r\n').encode())
        sys.stdout.buffer.write(data)
    elif response.status < 400:
        if jq:
            value = json.loads(data)
            for key in jq.lstrip('.').split('.'):
                value = value[key]
            print(value)
        else:
            sys.stdout.buffer.write(data)
    if response.status >= 400:
        sys.stderr.write('gh: %s (HTTP %d)\n' % (data.decode(), response.status))
        sys.exit(1)


main(sys.argv[1:])
